# Application
APP_NAME=FilmCortex
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Database
POSTGRES_USER=filmcortex
POSTGRES_PASSWORD=filmcortex
POSTGRES_DB=filmcortex
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://filmcortex:filmcortex@localhost:5433/filmcortex

# External services
TMDB_API_KEY=
TMDB_REQUESTS_PER_SECOND=30
TMDB_EXPORT_CACHE_DIR=.cache/tmdb_exports
TMDB_TOP_RATED_CURSOR_PATH=.cache/tmdb_pipeline/top_rated_next_page
TMDB_INITIAL_LOAD_LIMIT=500
TMDB_DAILY_EXPORT_LIMIT=100
TMDB_TRENDING_LIMIT=40
TMDB_TOP_RATED_LIMIT=100
TMDB_DISCOVER_LIMIT=100
RADARR_URL=
RADARR_API_KEY=

# Embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=100
