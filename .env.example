# Application
APP_NAME=FilmCortex
APP_ENV=development
APP_DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# Database
POSTGRES_USER=filmcortex
POSTGRES_PASSWORD=filmcortex
POSTGRES_DB=filmcortex
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://filmcortex:filmcortex@localhost:5433/filmcortex

# External services
TMDB_API_KEY=
TMDB_REQUESTS_PER_SECOND=30
TMDB_EXPORT_CACHE_DIR=.cache/tmdb_exports
RADARR_URL=
RADARR_API_KEY=

# Embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
